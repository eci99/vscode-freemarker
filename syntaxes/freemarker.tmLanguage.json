{
  "name": "FreeMarker",
  "scopeName": "text.html.ftl",
  "patterns": [
    { "include": "#comment" },
    { "include": "#squareComment" },
    { "include": "#interpolation" },
    { "include": "#squareInterpolation" },
    { "include": "#directive" },
    { "include": "#squareDirective" },
    { "include": "#userDirective" },
    { "include": "#squareUserDirective" },
    { "include": "text.html.basic" }
  ],
  "repository": {
    "comment": {
      "name": "comment.block.freemarker",
      "begin": "<#--",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.comment.begin.freemarker" }
      },
      "end": "-->",
      "endCaptures": {
        "0": { "name": "punctuation.definition.comment.end.freemarker" }
      }
    },
    "squareComment": {
      "name": "comment.block.freemarker",
      "begin": "\\[#--",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.comment.begin.freemarker" }
      },
      "end": "--\\]",
      "endCaptures": {
        "0": { "name": "punctuation.definition.comment.end.freemarker" }
      }
    },
    "interpolation": {
      "name": "meta.interpolation.freemarker",
      "begin": "(\\$|#)\\{",
      "beginCaptures": {
        "1": { "name": "punctuation.section.embedded.begin.freemarker" },
        "0": { "name": "punctuation.section.interpolation.begin.freemarker" }
      },
      "end": "}",
      "endCaptures": {
        "0": { "name": "punctuation.section.interpolation.end.freemarker" }
      },
      "patterns": [
        { "include": "#expression" }
      ]
    },
    "squareInterpolation": {
      "name": "meta.interpolation.freemarker",
      "begin": "\\[=",
      "beginCaptures": {
        "0": { "name": "punctuation.section.interpolation.begin.freemarker" }
      },
      "end": "\\]",
      "endCaptures": {
        "0": { "name": "punctuation.section.interpolation.end.freemarker" }
      },
      "patterns": [
        { "include": "#squareExpression" }
      ]
    },
    "directive": {
      "name": "meta.directive.freemarker",
      "begin": "</?(#)([A-Za-z_][A-Za-z0-9_-]*)",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.tag.freemarker" },
        "1": { "name": "punctuation.definition.tag.freemarker" },
        "2": { "name": "keyword.control.directive.freemarker" }
      },
      "end": ">",
      "endCaptures": {
        "0": { "name": "punctuation.definition.tag.freemarker" }
      },
      "patterns": [
        { "include": "#interpolation" },
        { "include": "#expression" }
      ]
    },
    "squareDirective": {
      "name": "meta.directive.freemarker",
      "begin": "\\[/?(#)([A-Za-z_][A-Za-z0-9_-]*)",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.tag.freemarker" },
        "1": { "name": "punctuation.definition.tag.freemarker" },
        "2": { "name": "keyword.control.directive.freemarker" }
      },
      "end": "\\]",
      "endCaptures": {
        "0": { "name": "punctuation.definition.tag.freemarker" }
      },
      "patterns": [
        { "include": "#interpolation" },
        { "include": "#squareExpression" }
      ]
    },
    "userDirective": {
      "name": "meta.directive.user.freemarker",
      "begin": "</?(@)([A-Za-z_][A-Za-z0-9_.-]*)",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.tag.freemarker" },
        "1": { "name": "punctuation.definition.tag.freemarker" },
        "2": { "name": "entity.name.function.freemarker" }
      },
      "end": ">",
      "endCaptures": {
        "0": { "name": "punctuation.definition.tag.freemarker" }
      },
      "patterns": [
        { "include": "#interpolation" },
        { "include": "#expression" }
      ]
    },
    "squareUserDirective": {
      "name": "meta.directive.user.freemarker",
      "begin": "\\[/?(@)([A-Za-z_][A-Za-z0-9_.-]*)",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.tag.freemarker" },
        "1": { "name": "punctuation.definition.tag.freemarker" },
        "2": { "name": "entity.name.function.freemarker" }
      },
      "end": "\\]",
      "endCaptures": {
        "0": { "name": "punctuation.definition.tag.freemarker" }
      },
      "patterns": [
        { "include": "#interpolation" },
        { "include": "#squareExpression" }
      ]
    },
    "squareExpression": {
      "patterns": [
        {
          "begin": "\\[",
          "beginCaptures": {
            "0": { "name": "punctuation.freemarker" }
          },
          "end": "\\]",
          "endCaptures": {
            "0": { "name": "punctuation.freemarker" }
          },
          "patterns": [{ "include": "#squareExpression" }]
        },
        { "include": "#expression" }
      ]
    },
    "expression": {
      "patterns": [
        {
          "name": "string.quoted.double.raw.freemarker",
          "begin": "(?<![A-Za-z0-9_.])r\"",
          "end": "\""
        },
        {
          "name": "string.quoted.single.raw.freemarker",
          "begin": "(?<![A-Za-z0-9_.])r'",
          "end": "'"
        },
        {
          "name": "string.quoted.double.freemarker",
          "begin": "\"",
          "end": "\"",
          "patterns": [{ "include": "#stringEscape" }]
        },
        {
          "name": "string.quoted.single.freemarker",
          "begin": "'",
          "end": "'",
          "patterns": [{ "include": "#stringEscape" }]
        },
        {
          "match": "\\?(abs|absoluteTemplateName|absolute_template_name|ancestors|api|blankToNull|blank_to_null|boolean|byte|c|cLowerCase|cUpperCase|c_lower_case|c_upper_case|capFirst|cap_first|capitalize|ceiling|children|chopLinebreak|chop_linebreak|chunk|cn|contains|counter|date|dateIfUnknown|date_if_unknown|datetime|datetimeIfUnknown|datetime_if_unknown|dedent|default|double|dropWhile|drop_while|emptyToNull|empty_to_null|endsWith|ends_with|ensureEndsWith|ensureStartsWith|ensure_ends_with|ensure_starts_with|esc|eval|evalJson|eval_json|exists|filter|first|float|floor|groups|hasApi|hasContent|hasNext|has_api|has_content|has_next|html|ifExists|if_exists|indent|index|indexOf|index_of|int|interpret|isBoolean|isCollection|isCollectionEx|isDate|isDateLike|isDateOnly|isDatetime|isDirective|isEnumerable|isEvenItem|isFirst|isHash|isHashEx|isIndexable|isInfinite|isLast|isMacro|isMarkupOutput|isMethod|isNan|isNode|isNumber|isOddItem|isSequence|isString|isTime|isTransform|isUnknownDateLike|is_boolean|is_collection|is_collection_ex|is_date|is_date_like|is_date_only|is_datetime|is_directive|is_enumerable|is_even_item|is_first|is_hash|is_hash_ex|is_indexable|is_infinite|is_last|is_macro|is_markup_output|is_method|is_nan|is_node|is_number|is_odd_item|is_sequence|is_string|is_time|is_transform|is_unknown_date_like|iso|isoH|isoHNZ|isoLocal|isoLocalH|isoLocalHNZ|isoLocalM|isoLocalMNZ|isoLocalMs|isoLocalMsNZ|isoLocalNZ|isoM|isoMNZ|isoMs|isoMsNZ|isoNZ|isoUtc|isoUtcH|isoUtcHNZ|isoUtcM|isoUtcMNZ|isoUtcMs|isoUtcMsNZ|isoUtcNZ|iso_h|iso_h_nz|iso_local|iso_local_h|iso_local_h_nz|iso_local_m|iso_local_m_nz|iso_local_ms|iso_local_ms_nz|iso_local_nz|iso_m|iso_m_nz|iso_ms|iso_ms_nz|iso_nz|iso_utc|iso_utc_h|iso_utc_h_nz|iso_utc_m|iso_utc_m_nz|iso_utc_ms|iso_utc_ms_nz|iso_utc_nz|itemCycle|itemParity|itemParityCap|item_cycle|item_parity|item_parity_cap|jString|j_string|join|jsString|js_string|jsonString|json_string|keepAfter|keepAfterLast|keepBefore|keepBeforeLast|keep_after|keep_after_last|keep_before|keep_before_last|keys|last|lastIndexOf|last_index_of|leftPad|left_pad|length|lines|long|lowerAbc|lowerCase|lower_abc|lower_case|map|markupString|markup_string|matches|max|min|namespace|new|nextSibling|next_sibling|noEsc|no_esc|nodeName|nodeNamespace|nodeType|node_name|node_namespace|node_type|number|numberToDate|numberToDatetime|numberToTime|number_to_date|number_to_datetime|number_to_time|parent|previousSibling|previous_sibling|removeBeginning|removeEnding|remove_beginning|remove_ending|replace|reverse|rightPad|right_pad|root|round|rtf|seqContains|seqIndexOf|seqLastIndexOf|seq_contains|seq_index_of|seq_last_index_of|sequence|short|size|sort|sortBy|sort_by|split|startsWith|starts_with|string|substring|switch|takeWhile|take_while|then|time|timeIfUnknown|time_if_unknown|trim|trimToNull|trim_to_null|truncate|truncateC|truncateCM|truncateM|truncateW|truncateWM|truncate_c|truncate_c_m|truncate_m|truncate_w|truncate_w_m|uncapFirst|uncap_first|upperAbc|upperCase|upper_abc|upper_case|url|urlPath|url_path|values|webSafe|web_safe|withArgs|withArgsLast|with_args|with_args_last|wordList|word_list|wrap|xhtml|xml)\\b",
          "name": "support.function.builtin.freemarker"
        },
        {
          "match": "(?<![A-Za-z0-9_.\\])\"'])\\.(args|autoEsc|auto_esc|callerTemplateName|caller_template_name|currentNode|currentTemplateName|current_node|current_template_name|dataModel|data_model|error|getOptionalTemplate|get_optional_template|globals|incompatibleImprovements|incompatible_improvements|lang|locale|localeObject|locale_object|locals|main|mainTemplateName|main_template_name|namespace|node|now|outputEncoding|outputFormat|output_encoding|output_format|pass|templateName|template_name|timeZone|time_zone|urlEscapingCharset|url_escaping_charset|vars|version)\\b",
          "name": "variable.language.freemarker"
        },
        {
          "match": "\\b(true|false|yes|no|null)\\b",
          "name": "constant.language.freemarker"
        },
        {
          "match": "\\b(?:0[xX][0-9A-Fa-f]+|[0-9]+(\\.[0-9]+)?)\\b",
          "name": "constant.numeric.freemarker"
        },
        {
          "match": "\\b(and|or|not|gt|gte|lt|lte|as|in|is|exists)\\b|&&|\\|\\||==|!=|<=|>=|[+*/%-]",
          "name": "keyword.operator.freemarker"
        },
        {
          "match": "[A-Za-z_][A-Za-z0-9_]*",
          "name": "variable.other.freemarker"
        },
        {
          "match": "[(){}\\[\\].,?:!<>=]",
          "name": "punctuation.freemarker"
        }
      ]
    },
    "stringEscape": {
      "patterns": [
        {
          "match": "\\\\.",
          "name": "constant.character.escape.freemarker"
        }
      ]
    }
  }
}